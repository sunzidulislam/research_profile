@article{explainderm_2025,
  title={ExplainDerm: Explainable Multimodal Fusion of Dermoscopic Images and Clinical Metadata for Skin Lesion Classification},
  author={Md. Robiul Islam, Md. Sunzidul Islam, Md Abdullah al Naim},
  journal={Under Review},
  year={2026},
  abstract={In this work, we propose ExplainDerm, an explainable multimodal deep learning model designed for skin lesion classification based on the HAM10000 dataset. The architecture consists of an EfficientNet-B3-based encoder to handle image modality and a separate branch responsible for processing patient-specific metadata like age, biological gender, and anatomical location of lesions, using learnable embeddings and a crossattention mechanism for contextual fusion. In contrast to all previous solutions employing Grad-CAM for visualization of saliency maps in visual modalities only, ExplainDerm implements an innovative dual-explainability technique, where Grad-CAM identifies spatially important features of a particular skin lesion, while SHAP estimates the importance of patient-related clinical information, offering different yet complementary information. Experiments conducted using stratified sampling and balanced data augmentations achieve an accuracy of 87.23%, 0.8761 weighted F1 score, and 0.9720 AUC-ROC value, significantly outperforming single-modality and na¨ıve concatenation approaches. Multiple ablation studies verify the effectiveness of all proposed components of our model, proving its high structural quality and superior performance.},
  abbr={Under Review},
  preview={explainderm.jpeg}
}

@article{medrag_2025,
  title={MedRAG: Retrieval-Augmented Multimodal Generation for Automated X-Ray Report Synthesis},
  author={Md. Sunzidul Islam, Md Badiuzzaman Shuvo, Anisa Walida },
  journal={Under Review},
  year={2026},
  abstract={Chest X-ray interpretation is difficult because of subtle abnormalities, structural overlap, and differences in diagnosis. While Vision Language Models (VLMs) and Large Language Models (LLMs) have improved automated radiology report creation, they still have issues with hallucinations, lack strong clinical grounding, and incur high computational costs. We introduce MedRAG, a Parameter-Efficient Fine-Tuning (PEFT) and Retrieval-Augmented Generation (RAG) framework for generating chest X-ray reports. It combines BLIP/BLIP-2 with LoRA/QLoRA adapters for efficient adaptation. It also includes a FAISS-based retrieval module to use clinically similar reports, which helps improve contextual reasoning and factual consistency. Tests on two datasets, ChestMNIST-224 and MIMIC-CXR, show strong performance across BLEU, ROUGE-L, BERTScore, and CheX-BERT metrics. This approach significantly lowers training costs compared to full fine-tuning methods. The results indicate that MedRAG effectively balances clinical accuracy, coherence, and efficiency, making it a suitable fit for resource-limited medical settings.},
  abbr={Under Review},
  preview={medrag.png}
}
